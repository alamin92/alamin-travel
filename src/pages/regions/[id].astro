---
import Base from '../../layouts/Base.astro';
import Badge from '../../components/Badge.astro';
import NYMap from '../../components/NYMap.astro';
import { loadPlaces, loadHubs, SCENARIO_DAYS, scenarioSlug } from '../../lib/data';
import { regions, regionById } from '../../lib/regions';
import { regionArea, findState } from '../../lib/areas';
import { interestLabels, kindLabels } from '../../lib/labels';
import { formatMinutes } from '../../lib/maps';

export function getStaticPaths() {
  return regions.map((r) => ({ params: { id: r.id } }));
}
const region = regionById[Astro.params.id!];
const area = regionArea[region.id];
const stateArea = findState(area.country, area.state)!;
const all = await loadPlaces();
const hubsAll = await loadHubs();
const inRegion = (x: { region: string; alsoRegions: string[] }) => x.region === region.id || x.alsoRegions.includes(region.id);
const places = all.filter(inRegion).sort((a, b) => Number(b.highlight) - Number(a.highlight) || a.name.localeCompare(b.name));
const hubs = hubsAll.filter(inRegion);
const MAX = 12; // a region can have hundreds of places, so show the major ones and link to the full filterable list
const farmsAll = places.filter((p) => p.interests.includes('seasonal'));
const restAll = places.filter((p) => !p.interests.includes('seasonal'));
const rest = restAll.slice(0, MAX);
const farms = farmsAll.slice(0, 6);
const counts = Object.fromEntries(regions.map((r) => [r.id, all.filter((p) => p.region === r.id).length]));
---
<Base title={`${region.name}: places to go and plan a trip`} description={`${region.blurb} Places, warnings, approximate drive times and official links.`}>
  <p class="crumb"><a href="/explore">Explore</a> › <a href={`/explore/${area.country}/${area.stateId}`}>{stateArea.name}</a></p>
  <div class="region-head">
    <div>
      <h1>{region.name}</h1>
      <p class="lead">{region.blurb}</p>
      <p class="muted">Regions follow the official <a href={region.official} rel="noopener">I LOVE NY vacation regions</a>. Counties: {region.counties.join(', ')}.</p>
      <p><a class="btn" href={`/browse?region=${region.id}`}>Filter {region.name} places</a></p>
    </div>
    <NYMap active={region.id} counts={counts} />
  </div>

  {hubs.length > 0 && (
    <>
      <h2>Pick a base town</h2>
      <p class="muted">See what fits nearby, and get a sample plan for 1 to 7 days.</p>
      <div class="grid">
        {hubs.map((h) => (
          <div class="card">
            <h3><a href={`/hubs/${h.id}`}>{h.name}</a></h3>
            <p class="muted">{h.blurb}</p>
            <p class="maps">{SCENARIO_DAYS.slice(0, 4).map((n) => <a href={`/plan/${h.id}/${scenarioSlug(n)}`}>{n} {n === 1 ? 'day' : 'days'}</a>)}</p>
          </div>
        ))}
      </div>
    </>
  )}

  <h2>{restAll.length > MAX ? `Major places in ${region.name}` : `Places in ${region.name}`}</h2>
  {rest.length === 0 && <p class="muted">No full guides here yet. Check the official site above, and the <a href="/my-lists">saved lists</a>.</p>}
  <div class="grid">
    {rest.map((p) => (
      <a class="card place-card" href={`/places/${p.id}`}>
        <Badge source={p.source} />
        <h3 style="margin-top:8px">{p.name}</h3>
        <p class="muted">{p.area} · {kindLabels[p.kind]} · about {formatMinutes(p.timeMinutes)}</p>
        <p>{p.summary}</p>
      </a>
    ))}
  </div>

  {restAll.length > MAX && (
    <p class="note">Showing {rest.length} of {restAll.length} places, major ones first. <a href={`/browse?region=${region.id}`}>Filter all {region.name} places</a> by interest, type or difficulty to see the rest.</p>
  )}

  {farms.length > 0 && (
    <>
      <h2>Farms and seasonal fun</h2>
      <p class="muted">Apple and pumpkin picking, festivals and more. These are seasonal: dates and what is open change every year, so check the farm's site before you go.</p>
      <div class="grid">
        {farms.map((p) => (
          <a class="card place-card" href={`/places/${p.id}`}>
            <Badge source={p.source} />
            <h3 style="margin-top:8px">{p.name}</h3>
            <p class="muted">{p.area} · best in {p.bestSeason.join(', ')}</p>
            <p>{p.summary}</p>
          </a>
        ))}
      </div>
      {farmsAll.length > farms.length && <p class="muted"><a href={`/browse?region=${region.id}&interest=seasonal`}>See all {farmsAll.length} farms and seasonal places</a></p>}
    </>
  )}
</Base>
