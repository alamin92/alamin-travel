---
import { buildNyMap } from '../lib/nymap';
interface Props { active?: string; counts?: Record<string, number> }
const { active, counts = {} } = Astro.props;
const W = 900, H = 660;
const map = buildNyMap(W, 640);
// Label lines and positions in map coordinates. Small and oddly shaped regions are placed by hand.
const labels: Record<string, { lines: string[]; x?: number; y?: number }> = {
  adirondacks: { lines: ['ADIRONDACKS'], x: 631, y: 105 },
  'thousand-islands-seaway': { lines: ['THOUSAND', 'ISLANDS-', 'SEAWAY'], x: 505, y: 92 },
  'capital-saratoga': { lines: ['CAPITAL-', 'SARATOGA'], x: 662, y: 322 },
  'central-ny': { lines: ['CENTRAL', 'NEW YORK'], x: 500, y: 300 },
  'finger-lakes': { lines: ['FINGER', 'LAKES'] },
  'greater-niagara': { lines: ['GREATER', 'NIAGARA'] },
  'chautauqua-allegheny': { lines: ['CHAUTAUQUA-', 'ALLEGHENY'] },
  catskills: { lines: ['THE', 'CATSKILLS'], x: 533, y: 412 },
  'hudson-valley': { lines: ['HUDSON', 'VALLEY'], x: 640, y: 466 },
  'long-island': { lines: ['LONG ISLAND'], x: 772, y: 548 },
  nyc: { lines: ['NEW YORK CITY'], x: 540, y: 640 },
};
---
<svg class="nymap" viewBox={`0 0 ${W} ${H}`} role="group" aria-label="Map of New York State vacation regions">
  {map.map((r) => (
    <a href={`/regions/${r.id}`} class={`region${active === r.id ? ' active' : ''}`} aria-label={`${r.name}${counts[r.id] ? `, ${counts[r.id]} places` : ''}`}>
      <path d={r.d} />
    </a>
  ))}
  <g class="labels" aria-hidden="true">
    {map.map((r) => {
      const l = labels[r.id] ?? { lines: [r.name] };
      const x = l.x ?? r.cx, y = (l.y ?? r.cy) - ((l.lines.length - 1) * 8.5);
      return <text text-anchor="middle">{l.lines.map((line, i) => <tspan x={x} y={y + i * 17}>{line}</tspan>)}</text>;
    })}
  </g>
</svg>
